#!/bin/sh
set -e

#INFO the third party code is not kept in this repository. every file is
#fetched from a pinned upstream commit and checked against its sha256, so a
#build is the same on every machine. to move to a newer version change the
#commit and the sum together

root=$(cd "$(dirname "$0")" && pwd)
destination="$root/src/external"

fetch() {
  repository=$1
  commit=$2
  file=$3
  sum=$4
  name=${5:-$file}

  if [ -f "$destination/$name" ] && echo "$sum  $destination/$name" | sha256sum -c - >/dev/null 2>&1
  then
    echo "[OK] $name"
    return
  fi

  curl -fsSL "https://raw.githubusercontent.com/$repository/$commit/$file" -o "$destination/$name"
  echo "$sum  $destination/$name" | sha256sum -c - >/dev/null
  echo "[OK] $name downloaded"
}

mkdir -p "$destination"

fetch nothings/stb 013ac3beddff3dbffafd5177e7972067cd2b5083 stb_image.h 594c2fe35d49488b4382dbfaec8f98366defca819d916ac95becf3e75f4200b3
fetch kgabis/parson ec53fb6528b45811df9db0db22cab96a94a96a11 parson.c a61370722e98609342278591c755a1632bf52281b0a054f2ef8a550ef456e799
fetch kgabis/parson ec53fb6528b45811df9db0db22cab96a94a96a11 parson.h 1909de7cdfa3b4383f2779ea6677b48a8a916ef975ca20c303ec5943459bb0f8
fetch jkuhlmann/cgltf de9828bc6419064c302546313ce8ff5eac6cd703 cgltf.h efb169dee911696b5d35fc8e3f7ea0c56d679debc529eba9ca6aa6443ba9d5e9
#INFO upstream names the C source lodepng.cpp, it is plain C and its own Makefile copies it to lodepng.c
fetch lvandeve/lodepng e584a8490db1b76b81bf298c11c09d3b55d9c270 lodepng.cpp 6aec876971ec860527859458d3095220fc5ee1258ec37eb59e1e7dd9cf136a81 lodepng.c
fetch lvandeve/lodepng e584a8490db1b76b81bf298c11c09d3b55d9c270 lodepng.h 9a1fca0238c38333bdc8545336961b73fd0b76957bbacf033186991be9d7cf85

#INFO cglm is many headers, so it is taken from the host when the compiler
#already finds it, and only otherwise fetched into src/external. include.make
#puts src/external after /usr/local/include on the include path, so a host copy
#always wins and the fetched one is only ever seen when there is no other.
#git checks the commit id, which stands in for the sha256 of each file
cglm_commit=144d1e7c29b3b0c6dede7917a0476cc95248559c

if echo '#include <cglm/cglm.h>' | cc -E -x c -I/usr/local/include - >/dev/null 2>&1
then
  echo "[OK] cglm found on the host"
elif [ -f "$destination/cglm/cglm.h" ]
then
  echo "[OK] cglm"
else
  checkout=$(mktemp -d)
  git -C "$checkout" init -q
  git -C "$checkout" fetch -q --depth 1 https://github.com/recp/cglm "$cglm_commit"
  git -C "$checkout" checkout -q FETCH_HEAD
  cp -r "$checkout/include/cglm" "$destination/cglm"
  rm -rf "$checkout"
  echo "[OK] cglm downloaded"
fi
